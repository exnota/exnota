{
  // Don't add docs folder (or any other) because it will prevent the workspace
  // loading as a dev container.
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "saveAndRunExt": {
      "commands": [
        {
          "match": "\\.(go$)",
          "isShellCommand": false,
          "cmd": "workbench.action.debug.restart"
        }
      ]
    },
    "markdown.extension.toc.levels": "2..3",
    "go.lintTool": "golangci-lint"
    // Using golangci-lint without --fast can apparently freeze VSCode, but it
    // omits some useful linters. For now it seems fine but the codebase is
    // small. If it starts freezing, uncomment the following.
    // "go.lintFlags": ["--fast"]
  },
  "extensions": {
    "recommendations": ["ldez.ignore-files"]
  }
}
