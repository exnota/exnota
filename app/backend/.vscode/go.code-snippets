{
	// Place your backend workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	"Return err": {
		"scope": "go",
		"prefix": "gre",
		"body": [
			"if err != nil {",
			"\treturn err",
			"}"
		],
		"description": "Checks if err is not nil and returns it"
	},
	"Return nil, err": {
		"scope": "go",
		"prefix": "gre2",
		"body": [
			"if err != nil {",
			"\treturn nil, err",
			"}"
		],
		"description": "Checks if err is not nil and returns nil, err"
	},
	"Create validator": {
		"scope": "go",
		"prefix": "gvalnew",
		"body": [
			"var validate = validator.New(validator.WithRequiredStructEnabled())",
		],
		"description": "Creates a re-usable validator"
	},
	"Validate struct": {
		"scope": "go",
		"prefix": "gvalstruct",
		"body": [
			"err := validate.Struct(${1:struct})",
			"if err != nil {",
			"\treturn err",
			"}",
		],
		"description": "Validates a struct"
	},
	"Collection Filter: Single": {
		"scope": "go",
		"prefix": "flt",
		"body": [
			"filter, err := filter.CreateAndFilter(",
			"\tfilter.Field{",
			"\t\tName:  ${1:field_name},",
			"\t\tOp:    filter.OpEquals,",
			"\t\tValue: ${2:field_value},",
			"\t},",
			")",
			"if err != nil {",
			"\treturn nil, err",
			"}"
		],
		"description": ""
	}
}