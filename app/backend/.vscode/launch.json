{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend",
      "type": "go",
      "request": "launch",
      //   "mode": "auto",
      "program": "${workspaceFolder}",
      "args": ["serve", "--http=0.0.0.0:8080", "--dev"]
    },
    {
      "name": "Backend (skip workers)",
      "type": "go",
      "request": "launch",
      //   "mode": "auto",
      "program": "${workspaceFolder}",
      "args": ["serve", "--http=0.0.0.0:8080", "--dev", "--skip-workers=true"]
    },
    {
      "name": "Tool: Test Seed",
      "type": "node",
      "cwd": "${workspaceFolder}/tool/test/seed",
      "request": "launch",
      "skipFiles": ["${workspaceFolder}/tool/test/seed/<node_internals>/**"],
      "program": "${workspaceFolder}/tool/test/seed/index.ts",
      "preLaunchTask": "tsc: build - tool/test/seed/tsconfig.json",
      "outFiles": ["${workspaceFolder}/tool/test/seed/out/**/*.js"]
    }
  ]
}
