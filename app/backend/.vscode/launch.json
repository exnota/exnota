{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend",
      "type": "go",
      "request": "launch",
      "program": "${workspaceFolder}/cmd",
      "args": [
        "serve",
        "--http=0.0.0.0:8080",
        "--dev",
        // Data directory needs to be set because dlv seems to always run from
        // the 'cmd' folder, even if "cwd" is set in this launch config or --wd
        // is passed to dlv via dlvFlags
        "--dir",
        "${workspaceFolder}/pb_data"
      ],
      "env": {
        "NOTION_OAUTH_CLIENT_ID": "${config:rest-client.environmentVariables.$shared.notionOauthClientId}",
        "NOTION_OAUTH_CLIENT_SECRET": "${config:rest-client.environmentVariables.$shared.notionOauthSecret}"
      }
    },
    {
      "name": "Backend (skip workers)",
      "type": "go",
      "request": "launch",
      "program": "${workspaceFolder}/cmd",
      "args": [
        "serve",
        "--http=0.0.0.0:8080",
        "--dev",
        "--skip-workers=true",
        // Data directory needs to be set because dlv seems to always run from
        // the 'cmd' folder, even if "cwd" is set in this launch config or --wd
        // is passed to dlv via dlvFlags
        "--dir",
        "${workspaceFolder}/pb_data"
      ]
    },
    {
      "name": "Tool: Test Seed",
      "type": "node",
      "cwd": "${workspaceFolder}/tool/test/seed",
      "request": "launch",
      "skipFiles": ["${workspaceFolder}/tool/test/seed/<node_internals>/**"],
      "program": "${workspaceFolder}/tool/test/seed/index.ts",
      "preLaunchTask": "tsc: build - tool/test/seed/tsconfig.json",
      "outFiles": ["${workspaceFolder}/tool/test/seed/out/**/*.js"]
    }
  ]
}
