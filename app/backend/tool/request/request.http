# Warning: Open `app/backend` for variables to work. Or save variables (see
# below) in a settings.json file in your workspace's .vscode folder.
# 
# Setup:
# 1. Install REST Client extension for VS Code.
# 2. Duplicate .vscode/settings.json.template to .vscode/settings.json
# 3. Add environment variable values.
#    - For Notion variables, follow 'Notion setup' steps below.
#
# Usage:
# 1. Set environment:
#      * Cmd (⇧⌘P) > Rest Client: Switch Environment
#      * This will fix red lines.
# 2. Quick navigation
#      * Search (⌘P) > '@'

### ----------------------------------------------------
### Pocketbase API
### ----------------------------------------------------
### List all blocks
GET {{baseUrl}}/collections/block/records HTTP/1.1
content-type: application/json
Authorization: {{auth_token}}

### Create voice note - short
POST {{baseUrl}}/collections/block/records HTTP/1.1
Authorization: {{auth_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="type"
Content-Type: application/json

voice-note
--boundary
Content-Disposition: form-data; name="user"
Content-Type: application/json

{{user_id}}
--boundary
Content-Disposition: form-data; name="userCreated"
Content-Type: application/json

{{$datetime iso8601}}
--boundary
Content-Disposition: form-data; name="file"; filename="jfk.wav"
Content-Type: audio/wav

< jfk.wav
--boundary--

### Create voice note - long, without destination
POST {{baseUrl}}/collections/block/records HTTP/1.1
Authorization: {{auth_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="type"
Content-Type: application/json

voice-note
--boundary
Content-Disposition: form-data; name="user"
Content-Type: application/json

{{user_id}}
--boundary
Content-Disposition: form-data; name="userCreated"
Content-Type: application/json

{{$datetime iso8601}}
--boundary
Content-Disposition: form-data; name="file"; filename="5min.mp3"
Content-Type: audio/wav

< 5min.mp3
--boundary--

### Create text note
POST {{baseUrl}}/collections/block/records HTTP/1.1
Authorization: {{auth_token}}
Content-Type: application/json

{
    "type": "text-note",
    "title": "block title",
    "destination": "{{destination}}",
    "user": "{{user_id}}",
    "userCreated": "{{$datetime iso8601}}"
}

### Update block - text note title
PATCH {{baseUrl}}/collections/block/records/qpd2wx0ryerqhw1 HTTP/1.1
Authorization: {{auth_token}}
Content-Type: application/json

{
    "title": "block title 2"
}

### Update block - add destination
PATCH {{baseUrl}}/collections/block/records/cyisf9bp0w2r00v HTTP/1.1
Authorization: {{auth_token}}
Content-Type: application/json

{
  "destination": "{{destination}}"
}

### Create integration - See 'Exnota auth' section below.

### Create workspace
POST {{baseUrl}}/collections/workspace/records HTTP/1.1
Authorization: {{auth_token}}
Content-Type: application/json

{
    "name": "test workspace",
    "type": "database",
    "integration": "{{integration}}",
    "user": "{{user_id}}"
}

// format
// 0de9f446-6a57-4282-b449-ddfce8a59499

### Create destination
POST {{baseUrl}}/collections/destination/records HTTP/1.1
Authorization: {{auth_token}}
Content-Type: application/json

{
    "id": "c4a300da2b84aaf",
    "name": " ",
    "workspace": "{{workspace}}",
    "user": "{{user_id}}",
    "external": {
      "config": {
        "id": "d01261c86c5344b49ece3116f43057c1",
        "object": "database"
      }
    }
}

### Update destination - integration
PATCH {{baseUrl}}/collections/destination/records/c4a300da2b84aad HTTP/1.1
Authorization: {{auth_token}}
Content-Type: application/json

{
  "external": {
      "config": {
        "id": "c9d9afd7-b130-4880-b373-64d3ec384488",
        "object": "page"
      },
      "notion_status": "other"
  }
}

### Get notion integration
GET {{baseUrl}}/collections/integration/records
  ?filter=type = "notion"
Authorization: {{auth_token}}


### ----------------------------------------------------
### Exnota user auth
### ----------------------------------------------------

### Auth with password
###
### Use token from response for auth_token variable.
POST {{baseUrl}}/collections/user/auth-with-password HTTP/1.1
content-type: application/json

{
	"identity": "{{username}}",
	"password": "{{password}}"
}

### ----------------------------------------------------
### Exnota Notion auth
### ----------------------------------------------------

### Create integration
###
### 1/3: Get path for code
GET {{baseUrl}}/exnota/integration/notion/mobile-code-request-path HTTP/1.1
content-type: application/json

{}

### 2/3: Get code
# 1. Copy path from previous step.
# 2. Open in browser AND START CAPTURING NETWORK REQUESTS
# 3. Go through flow, and get code from attempted redirect
#    (won't actually redirect due to exnota:// scheme).

### 3a/3: Create an integration with the code
POST {{baseUrl}}/collections/integration/records HTTP/1.1
Authorization: {{auth_token}}
Content-Type: application/json

{
    "type": "notion",
    "user": "{{user_id}}",
    "status": "connected",
    "config": {
      "auth": {
        "code": "0338c8b3-8d4e-4d71-921d-8dd436b46687"
      }
    }
}

### 3b/3: Update an integration with the code
PATCH {{baseUrl}}/collections/integration/records/{{integration}} HTTP/1.1
Authorization: {{auth_token}}
Content-Type: application/json

{
    "config": {
      "auth": {
        "code": "03f1f148-db6e-40de-8942-84d8b75f8a26"
      }
    }
}

### Verify integration
POST {{baseUrl}}/exnota/integration/verify-access
content-type: application/json
Authorization: {{auth_token}}

{
  "integration_id": "{{integration}}"
}

### Sync integration destinations
POST {{baseUrl}}/exnota/integration/sync-destinations
content-type: application/json
Authorization: {{auth_token}}

{
  "integration_id": "{{integration}}"
}

### Get suggested destinations
GET {{baseUrl}}/exnota/workspace/get-suggested-destinations
content-type: application/json
Authorization: {{auth_token}}

{
  "workspace_id": "{{workspace}}"
}

### Search destinations - database
GET {{baseUrl}}/exnota/workspace/search-destinations
content-type: application/json
Authorization: {{auth_token}}

{
  "workspace_id": "{{workspace}}",
  "query": ""
}


### ----------------------------------------------------
### Notion API
###
### API reference: https://developers.notion.com/reference/intro
###
### ----------------------------------------------------


### Search any
curl -X POST 'https://api.notion.com/v1/search' \
  -H 'Authorization: Bearer '"{{notionAccessTokenSecondTestUser}}"'' \
  -H 'Content-Type: application/json' \
  -H 'Notion-Version: 2022-06-28' \
  --data '{
    "sort":{
      "direction":"ascending",
      "timestamp":"last_edited_time"
    }
  }'

### Search databases
curl -X POST 'https://api.notion.com/v1/search' \
  -H 'Authorization: Bearer '"{{notionAccessTokenSecondTestUser}}"'' \
  -H 'Content-Type: application/json' \
  -H 'Notion-Version: 2022-06-28' \
  --data '{
    "sort":{
      "direction":"ascending",
      "timestamp":"last_edited_time"
    },
    "filter":{
      "value":"database",
      "property":"object"
    }
  }'

### blocks - append file block
curl -X PATCH 'https://api.notion.com/v1/blocks/18f8ea6881a443908fed7aa4f6b767af/children' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H "Content-Type: application/json" \
  -H "Notion-Version: 2022-06-28" \
  --data '{
  "after": "9d0d04fe364048e2b844ac308fdd627a",
	"children": [
		{
			"object": "block",
			"type": "file",
			"file": {
        "name": "Voice memo (exnota file id 43auucm9xdi41yc)",
				"caption": [{
          "type": "text",
          "text": {
            "content": "Exnota id: 43auucm9xdi41yc",
            "link": null
          },
          "annotations": {
            "bold": false,
            "italic": false,
            "strikethrough": false,
            "underline": false,
            "code": false,
            "color": "default"
          },
          "plain_text": "Exnota id: 43auucm9xdi41yc",
          "href": null
        }],
				"type": "external",
				"external": {
					"url": "https://upload.wikimedia.org/wikipedia/commons/d/d5/JFK_inaugural_address.ogg"
				}
			}
		}
	]
}'

### Update page title (database or child)
curl -X PATCH 'https://api.notion.com/v1/pages/70d0b23b3b6a4532aaff672ac655894d' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Content-Type: application/json' \
  -H 'Notion-Version: 2022-06-28' \
	--data '{
  "properties": {
    "title": {
			"title": [
				{
					"text": {
						"content": "One level below root page UPDATED 2"
					}
				}
			]
		}
  }
}'


### Fetch page (doesn't include children)
curl 'https://api.notion.com/v1/pages/881db3d4d93f4a518d38d048930f9591' \
  -H 'Notion-Version: 2022-06-28' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"''

### Fetch block children (can be used to get page's content)
curl 'https://api.notion.com/v1/blocks/58f88d962c5c4f3a8d02278090b17844/children?page_size=100' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H "Notion-Version: 2022-06-28"

### Fetch block
curl 'https://api.notion.com/v1/blocks/9d93cd05-5f0d-4e67-ae8c-a3d66d0a0715' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Notion-Version: 2022-06-28'

### Fetch database
curl 'https://api.notion.com/v1/databases/b4e76e989a734853be432baca901299d' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Notion-Version: 2022-06-28'

### Update database
curl --location --request PATCH 'https://api.notion.com/v1/databases/b4e76e989a734853be432baca901299d' \
--header 'Authorization: Bearer '"{{notionAccessToken}}"'' \
--header 'Content-Type: application/json' \
--header 'Notion-Version: 2022-06-28' \
--data '{
  "properties": {
    "parent 1": {
      "name": "parent 1",
      "type": "relation",
      "relation": {
        "database_id": "b4e76e98-9a73-4853-be43-2baca901299d",
        "type": "single_property",
        "single_property": {}
      }
    }
  }
}'


### Create database page
curl 'https://api.notion.com/v1/pages' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H "Content-Type: application/json" \
  -H "Notion-Version: 2022-06-28" \
  --data '{
	"parent": { "database_id": "b77407e655b242fab5556307371cb3f6" },
	"properties": {
		"Name": {
			"title": [
				{
					"text": {
						"content": "a title"
					}
				}
			]
		}
	},
	"children": [
		{
			"object": "block",
			"type": "heading_2",
			"heading_2": {
				"rich_text": [{ "type": "text", "text": { "content": "Lacinato kale" } }]
			}
		},
		{
			"object": "block",
			"type": "paragraph",
			"paragraph": {
				"rich_text": [
					{
						"type": "text",
						"text": {
							"content": "Lacinato kale is a variety of kale with a long tradition in Italian cuisine, especially that of Tuscany. It is also known as Tuscan kale, Italian kale, dinosaur kale, kale, flat back kale, palm tree kale, or black Tuscan palm.",
							"link": { "url": "https://en.wikipedia.org/wiki/Lacinato_kale" }
						}
					}
				]
			}
		}
	]
}'

### ----------------------------------------------------
### OpenAI Whisper
### ----------------------------------------------------

### Transcribe
POST https://api.openai.com/v1/audio/transcriptions
Content-Type: multipart/form-data; boundary=boundary
Authorization: Bearer {{openAiKey}}

--boundary
Content-Disposition: form-data; name="model"
Content-Type: application/json

whisper-1
--boundary
Content-Disposition: form-data; name="file"; filename="short-test.m4a"
Content-Type: audio/x-m4a

< short-test.m4a
--boundary--
