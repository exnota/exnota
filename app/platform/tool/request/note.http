### ----------------------------------------------------
### local
### ----------------------------------------------------
### ----------
### note
### ----------
### get
GET http://localhost:3000/notes

### post m4a short
POST http://localhost:3000/notes
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="short-test.m4a"
Content-Type: audio/x-m4a

< short-test.m4a
--boundary--

### post wav jfk
POST http://localhost:3000/notes
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="jfk.wav"
Content-Type: audio/wav

< jfk.wav
--boundary--

### post wav micromachines 44k
POST http://localhost:3000/notes
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="micro-machines-44k.wav"
Content-Type: audio/wav

< micro-machines-44k.wav
--boundary--

### ----------
### integration
### ----------
### notion token
POST http://localhost:3000/notion-token HTTP/1.1
content-type: application/json

{
    "code": "a code"
}

