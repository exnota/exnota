# Setup:
# 1. Install REST Client extension for VS Code.
# 2. Cmd > Preferences: Open User Settings (JSON)
# 3. Add:
#   "rest-client.environmentVariables": {
#     "$shared": {
#         "notionAccessToken": "<token>"
#     },
#     "local": {
#         "baseUrl": "http://localhost:3000"
#     },
#     "production": {
#         "baseUrl": "https://exnota.com/api"
#     }
#   }
# 4. Get a Notion access token and update the notionAccessToken variable.
#
# Usage:
# 1. Change environment:
#      * Cmd (⇧⌘P) > Rest Client: Switch Environment
#      * This will fix red lines.
# 2. Quick navigation
#      * Search (⌘P) > '@'

### ----------------------------------------------------
### note endpoints
### ----------------------------------------------------
### get notes
GET {{baseUrl}}/note/notes

### post notes - m4a short
POST {{baseUrl}}/note/notes
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="type"
Content-Type: application/json

audio
--boundary
Content-Disposition: form-data; name="accessToken"
Content-Type: application/json

{{notionAccessToken}}
--boundary
Content-Disposition: form-data; name="file"; filename="short-test.m4a"
Content-Type: audio/x-m4a

< short-test.m4a
--boundary--

### post notes - wav jfk
POST {{baseUrl}}/note/notes
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="type"
Content-Type: application/json

audio
--boundary
Content-Disposition: form-data; name="accessToken"
Content-Type: application/json

{{notionAccessToken}}
--boundary
Content-Disposition: form-data; name="file"; filename="jfk.wav"
Content-Type: audio/wav

< jfk.wav
--boundary--

### post notes - wav 44k micromachines
POST {{baseUrl}}/note/notes
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="type"
Content-Type: application/json

audio
--boundary
Content-Disposition: form-data; name="accessToken"
Content-Type: application/json

access token
--boundary
Content-Disposition: form-data; name="file"; filename="micro-machines-44k.wav"
Content-Type: audio/wav

< micro-machines-44k.wav
--boundary--

### ----------------------------------------------------
### integration endpoints
### ----------------------------------------------------
### generate notion token
POST {{baseUrl}}/notion-token HTTP/1.1
content-type: application/json

{
    "code": "a code"
}

### ----------------------------------------------------
### notion api
### ----------------------------------------------------
### 
curl -X PATCH 'https://api.notion.com/v1/blocks/2daf121ec2e742299da72e1df4eb67b9/children' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H "Content-Type: application/json" \
  -H "Notion-Version: 2022-06-28" \
  --data '{
	"children": [
		{
			"object": "block",
			"type": "heading_2",
			"heading_2": {
				"rich_text": [{ "type": "text", "text": { "content": "Lacinato kale" } }]
			}
		},
		{
			"object": "block",
			"type": "paragraph",
			"paragraph": {
				"rich_text": [
					{
						"type": "text",
						"text": {
							"content": "Lacinato kale is a variety of kale with a long tradition in Italian cuisine, especially that of Tuscany. It is also known as Tuscan kale, Italian kale, dinosaur kale, kale, flat back kale, palm tree kale, or black Tuscan palm.",
							"link": { "url": "https://en.wikipedia.org/wiki/Lacinato_kale" }
						}
					}
				]
			}
		}
	]
}'